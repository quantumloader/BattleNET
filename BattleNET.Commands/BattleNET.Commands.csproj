<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BattleNET.Commands</RootNamespace>
    <AssemblyName>BattleNET.Commands</AssemblyName>
    <Version>2.0.0</Version>
    <Authors>quantumloader</Authors>
    <Description>Typed BattlEye RCon commands and response parsers for BattleNET.Core.</Description>
    <PackageTags>battleye;rcon;arma;dayz;server</PackageTags>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BattleNET.Core\BattleNET.Core.csproj" />
  </ItemGroup>

</Project>
