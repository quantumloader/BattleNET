<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BattleNET.Cli</RootNamespace>
    <AssemblyName>BattleNET</AssemblyName>
    <Version>2.0.0</Version>
    <Authors>quantumloader</Authors>
    <Description>BattleNET BattlEye RCon console client.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>battlenet</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BattleNET.Commands\BattleNET.Commands.csproj" />
  </ItemGroup>

</Project>
